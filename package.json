{
  "name": "deutsch-trainer-blackcard",
  "private": true,
  "version": "1.0.0",
  "description": "DEUTSCH TRAINER // BLACKCARD — quiz multijugador de alemán A1–A2 para una clase de 2 horas: juego + actividades de escritura, rol y Wort-Jenga",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --disable-warning=ExperimentalWarning server/index.ts",
    "test": "vitest run",
    "check": "tsc --noEmit",
    "e2e": "node --disable-warning=ExperimentalWarning scripts/e2e.mjs",
    "ui": "node --disable-warning=ExperimentalWarning scripts/ui.mjs",
    "tour": "node --disable-warning=ExperimentalWarning scripts/tour.mjs",
    "bank": "node --disable-warning=ExperimentalWarning scripts/bankstats.mjs",
    "overflow": "node --disable-warning=ExperimentalWarning scripts/overflow.mjs"
  },
  "dependencies": {
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "@fontsource-variable/doto": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@types/node": "^22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
