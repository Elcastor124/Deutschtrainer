# Plantilla de configuración. Copiar a .env (ignorado por git) y NUNCA poner valores reales aquí.
# --- Desarrollo local (por defecto) ---
PORT=4747
DATA_DIR=./data                 # datos de PRUEBA; nunca apuntar a la carpeta de producción
INSTANCE_LOCK_WAIT_MS=35000
# --- Producción (Render, en el panel; no en el repo) ---
# TRUST_PROXY=1
# TEACHER_AUTH=optional|required|off
# TEACHER_PASSWORD=<secreto>
# SUPABASE_URL=<secreto>                 # copia de seguridad opcional de DATA_DIR
# SUPABASE_SERVICE_ROLE_KEY=<secreto>    # solo la service role; nunca en el cliente

# --- Klaus AI (todo opcional; sin esto funciona en modo determinista y NO gasta nada) ---
# Un proveedor real solo se activa si: *_PROVIDER lo pide + hay clave + KLAUS_ALLOW_PAID=1 + están definidos sus precios.
# KLAUS_ALLOW_PAID=1
# KLAUS_BUDGET_EUR=10                    # tope total; KLAUS_DAILY_BUDGET_EUR = tope diario
# KLAUS_LLM_PROVIDER=anthropic           # ANTHROPIC_API_KEY=<secreto>
# KLAUS_LLM_MODEL=<modelo>
# KLAUS_LLM_PRICE_IN_PER_M=<USD por millón de tokens de entrada>
# KLAUS_LLM_PRICE_OUT_PER_M=<USD por millón de tokens de salida>
# KLAUS_STT_PROVIDER=openai              # OPENAI_API_KEY=<secreto>; KLAUS_STT_MODEL, KLAUS_STT_PRICE_PER_MIN
# KLAUS_TTS_PROVIDER=openai              # KLAUS_TTS_MODEL, KLAUS_TTS_VOICE, KLAUS_TTS_PRICE_PER_*
# KLAUS_EUR_PER_USD=<cambio>
#
# IA GRATUITA (recomendado): OpenRouter solo con modelos «:free». No necesita KLAUS_ALLOW_PAID y nunca cobra:
# solo envía ids «:free», cada petición lleva max_price=0 y si OpenRouter informara de un coste > 0 la IA se apaga.
# Si los modelos gratis están saturados, Klaus responde en modo básico (sin error para el alumno).
# KLAUS_LLM_PROVIDER=openrouter-free
# OPENROUTER_API_KEY=<secreto>   OPENROUTER_API_KEY_2=<secreto opcional, reserva>
# KLAUS_FREE_MODELS=<lista opcional de ids terminados en :free>
# KLAUS_PLUS_ALIASES=alias1,alias2       # cuentas con cuota Plus mientras no hay pagos
# KLAUS_LIMITS_FREE={"text":3}  KLAUS_LIMITS_PLUS={"text":25}   # cuotas diarias editables
# KLAUS_REDET_RETENTION_DAYS=30  KLAUS_KLASSE_RETENTION_DAYS=30
