# Plantilla de configuración. Copiar a .env (ignorado por git) y NUNCA poner valores reales aquí.
# --- Desarrollo local (por defecto) ---
PORT=4747
DATA_DIR=./data                 # datos de PRUEBA; nunca apuntar a la carpeta de producción
INSTANCE_LOCK_WAIT_MS=35000
# --- Producción (Render, en el panel; no en el repo) ---
# TRUST_PROXY=1
# TEACHER_AUTH=optional|required|off
# TEACHER_PASSWORD=<secreto>
# SUPABASE_URL=<secreto>                 # copia de seguridad opcional de DATA_DIR
# SUPABASE_SERVICE_ROLE_KEY=<secreto>    # solo la service role; nunca en el cliente
